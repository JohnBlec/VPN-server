COMPOSE_PROJECT_NAME=aegis-vpn
VPN_IMAGE_TAG=2026.09.25-1
# Public IPv4 address or DNS name pointing directly to the VPS (no HTTP proxy).
VPN_ENDPOINT=vpn.example.com
VPN_PORT=443
# API is published ONLY on the host loopback interface.
AGENT_PORT=8787
# Immutable after initialization; choose a subnet not used by the VPS/site/LAN.
VPN_SUBNET=10.77.0.0/24
VPN_DNS=1.1.1.1,1.0.0.1
VPN_MTU=1280
# Verified source references, not floating master/latest. See docs/SOURCES.md.
AWG_GO_COMMIT=b5928efb6ca19f0153958460c3d141f04abc5c2e
AWG_TOOLS_COMMIT=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843
